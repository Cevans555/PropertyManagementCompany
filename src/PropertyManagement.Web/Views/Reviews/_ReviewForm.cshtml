@model ReviewFormViewModel

<form method="post" action="@Url.Action("Review", "Reviews", new { id = Model.ApplicationId })" asp-antiforgery="true">
    <div class="modal-header">
        <div>
            <h2 class="modal-title fs-5">Review application</h2>
            <div class="small text-muted">@Model.UnitLabel</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2" role="alert"></div>

        <fieldset class="mb-3">
            <legend class="form-label fs-6 fw-semibold">Decision</legend>
            <div class="choice-group">
                <label class="choice-card" for="outcome-approve">
                    <input class="form-check-input" type="radio" asp-for="Outcome" id="outcome-approve" value="@ReviewOutcome.Approve" />
                    <span>
                        <span class="choice-title">Approve</span>
                        <span class="choice-help">Create a 12-month lease</span>
                    </span>
                </label>
                <label class="choice-card" for="outcome-return">
                    <input class="form-check-input" type="radio" asp-for="Outcome" id="outcome-return" value="@ReviewOutcome.Return" />
                    <span>
                        <span class="choice-title">Return</span>
                        <span class="choice-help">Send back to the applicant for changes</span>
                    </span>
                </label>
                <label class="choice-card" for="outcome-deny">
                    <input class="form-check-input" type="radio" asp-for="Outcome" id="outcome-deny" value="@ReviewOutcome.Deny" />
                    <span>
                        <span class="choice-title">Deny</span>
                        <span class="choice-help">Decline this application</span>
                    </span>
                </label>
            </div>
            <span asp-validation-for="Outcome" class="text-danger"></span>
        </fieldset>

        <div class="mb-3" data-show-when="Outcome" data-show-value="@ReviewOutcome.Approve">
            <label asp-for="LeaseStartDate" class="form-label"></label>
            <input asp-for="LeaseStartDate" class="form-control" type="date" min="@Model.Today.ToString("yyyy-MM-dd")" aria-describedby="lease-start-help" />
            <div class="form-text" id="lease-start-help">The lease runs 12 months from this date. Today or later.</div>
            <span asp-validation-for="LeaseStartDate" class="text-danger"></span>
        </div>

        <div>
            <label asp-for="Comment" class="form-label"></label>
            <textarea asp-for="Comment" class="form-control" rows="3" aria-describedby="comment-help"></textarea>
            <div class="form-text" id="comment-help">Required to return or deny. Recorded in the status history.</div>
            <span asp-validation-for="Comment" class="text-danger"></span>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Submit review</button>
    </div>
</form>
