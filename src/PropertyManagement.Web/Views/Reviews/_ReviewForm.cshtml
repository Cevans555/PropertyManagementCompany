@model ReviewFormViewModel

<form method="post" action="@Url.Action("Review", "Reviews", new { id = Model.ApplicationId })" asp-antiforgery="true">
    <div class="modal-header">
        <div>
            <h2 class="modal-title fs-5">Complete review</h2>
            <div class="small text-muted">@Model.UnitLabel</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2" role="alert"></div>

        <fieldset class="mb-3">
            <legend class="form-label fs-6 fw-semibold">Outcome</legend>
            <div class="form-check">
                <input class="form-check-input" type="radio" asp-for="Outcome" id="outcome-approve" value="@ReviewOutcome.Approve" />
                <label class="form-check-label" for="outcome-approve">Approve and create a 12-month lease</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" asp-for="Outcome" id="outcome-return" value="@ReviewOutcome.Return" />
                <label class="form-check-label" for="outcome-return">Return to the applicant for changes</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" asp-for="Outcome" id="outcome-deny" value="@ReviewOutcome.Deny" />
                <label class="form-check-label" for="outcome-deny">Deny</label>
            </div>
            <span asp-validation-for="Outcome" class="text-danger"></span>
        </fieldset>

        <div class="mb-3" data-show-when="Outcome" data-show-value="@ReviewOutcome.Approve">
            <label asp-for="LeaseStartDate" class="form-label"></label>
            <input asp-for="LeaseStartDate" class="form-control" type="date" min="@Model.Today.ToString("yyyy-MM-dd")" />
            <div class="form-text">The lease runs 12 months from this date. Today or later.</div>
            <span asp-validation-for="LeaseStartDate" class="text-danger"></span>
        </div>

        <div>
            <label asp-for="Comment" class="form-label"></label>
            <textarea asp-for="Comment" class="form-control" rows="3"></textarea>
            <div class="form-text">Required to return or deny. Recorded in the status history.</div>
            <span asp-validation-for="Comment" class="text-danger"></span>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save review</button>
    </div>
</form>
