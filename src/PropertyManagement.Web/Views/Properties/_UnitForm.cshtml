@model UnitFormViewModel
@{
    var isNew = Model.Id is null;
    var postUrl = isNew
        ? Url.Action("CreateUnit", new { propertyId = Model.PropertyId })
        : Url.Action("EditUnit", new { id = Model.Id });
}

<form method="post" action="@postUrl" asp-antiforgery="true">
    <div class="modal-header">
        <div>
            <h2 class="modal-title fs-5">@(isNew ? "Add unit" : $"Edit unit {Model.UnitNumber}")</h2>
            <div class="small text-muted">@Model.PropertyName</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2" role="alert"></div>

        <div class="row g-3">
            <div class="col-sm-6">
                <label asp-for="UnitNumber" class="form-label"></label>
                <input asp-for="UnitNumber" class="form-control" />
                <span asp-validation-for="UnitNumber" class="text-danger"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="UnitTypeId" class="form-label"></label>
                <select asp-for="UnitTypeId" asp-items="Model.UnitTypeOptions" class="form-select">
                    <option value="">Choose...</option>
                </select>
                <span asp-validation-for="UnitTypeId" class="text-danger"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="Bedrooms" class="form-label"></label>
                <input asp-for="Bedrooms" class="form-control" min="0" max="@PropertyManagement.Core.Entities.Unit.MaxBedrooms" />
                <span asp-validation-for="Bedrooms" class="text-danger"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="MonthlyRent" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input asp-for="MonthlyRent" class="form-control" step="1" min="1" />
                </div>
                <span asp-validation-for="MonthlyRent" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">@(isNew ? "Add unit" : "Save changes")</button>
    </div>
</form>
