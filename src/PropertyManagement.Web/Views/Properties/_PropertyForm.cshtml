@model PropertyFormViewModel
@{
    var isNew = Model.Id is null;
    var postUrl = isNew ? Url.Action("Create") : Url.Action("Edit", new { id = Model.Id });
}

<form method="post" action="@postUrl" asp-antiforgery="true">
    <div class="modal-header">
        <h2 class="modal-title fs-5">@(isNew ? "Add property" : "Edit property")</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2" role="alert"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Street" class="form-label"></label>
            <input asp-for="Street" class="form-control" autocomplete="street-address" />
            <span asp-validation-for="Street" class="text-danger"></span>
        </div>

        <div class="row g-3">
            <div class="col-sm-5">
                <label asp-for="City" class="form-label"></label>
                <input asp-for="City" class="form-control" autocomplete="address-level2" />
                <span asp-validation-for="City" class="text-danger"></span>
            </div>
            <div class="col-sm-3">
                <label asp-for="State" class="form-label"></label>
                <input asp-for="State" class="form-control" autocomplete="address-level1" />
                <span asp-validation-for="State" class="text-danger"></span>
            </div>
            <div class="col-sm-4">
                <label asp-for="PostalCode" class="form-label"></label>
                <input asp-for="PostalCode" class="form-control" autocomplete="postal-code" />
                <span asp-validation-for="PostalCode" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">@(isNew ? "Add property" : "Save changes")</button>
    </div>
</form>
