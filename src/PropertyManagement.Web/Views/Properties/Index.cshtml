@{
    ViewData["Title"] = "Properties";
}

<div class="page-header">
    <div>
        <h1>Properties</h1>
        <p class="page-subtitle">Each property holds the units an applicant can apply for.</p>
    </div>
    <div class="page-actions">
        <button type="button" class="btn btn-primary"
                data-modal-url="@Url.Action("Create")"
                data-modal-refresh="#property-list">
            Add property
        </button>
    </div>
</div>

<div id="property-list" data-refresh-url="@Url.Action("List")">
    @await Component.InvokeAsync("PropertyList")
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
