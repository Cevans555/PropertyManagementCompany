@model PropertyHeaderViewModel
@{
    ViewData["Title"] = Model.Name;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Properties</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
    </ol>
</nav>

<div class="page-header">
    <div>
        <h1>@Model.Name</h1>
        <p class="page-subtitle">@Model.Street, @Model.City, @Model.State @Model.PostalCode</p>
    </div>
    <div class="page-actions">
        <button type="button" class="btn btn-primary"
                data-modal-url="@Url.Action("Create", "Units", new { propertyId = Model.Id })"
                data-modal-refresh="#unit-table">
            Add unit
        </button>
    </div>
</div>

<div id="unit-table" data-refresh-url="@Url.Action("Table", "Units", new { id = Model.Id })">
    @await Component.InvokeAsync("UnitTable", new { propertyId = Model.Id })
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
