@model PropertyHeaderViewModel
@{
    ViewData["Title"] = Model.Name;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Properties</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">@Model.Name</h1>
        <p class="text-muted mb-0">@Model.Street, @Model.City, @Model.State @Model.PostalCode</p>
    </div>
    <button type="button" class="btn btn-primary"
            data-modal-url="@Url.Action("Create", "Units", new { propertyId = Model.Id })"
            data-modal-refresh="#unit-table">
        Add unit
    </button>
</div>

<div id="unit-table" data-refresh-url="@Url.Action("Table", "Units", new { id = Model.Id })">
    @await Component.InvokeAsync("UnitTable", new { propertyId = Model.Id })
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
