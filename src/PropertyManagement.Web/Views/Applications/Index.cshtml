@model ApplicationListPageViewModel
@{
    ViewData["Title"] = Model.IsManager ? "Applications" : "My applications";
}

<div class="page-header">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p class="page-subtitle">
            @(Model.IsManager
                ? "Every application, filtered and paged in the database."
                : "Applications you are named on, including ones a co-applicant started.")
        </p>
    </div>
    @if (!Model.IsManager)
    {
        <div class="page-actions">
            <a class="btn btn-outline-primary" asp-action="Available">Browse available units</a>
        </div>
    }
</div>

<form id="@ApplicationListPageViewModel.FilterFormId" method="get" asp-action="Index" class="row g-2 align-items-end mb-4" role="search" aria-label="Filter applications">
    <div class="col-sm-4 col-lg-3">
        <label for="status" class="form-label">Status</label>
        <select id="status" name="status" class="form-select" asp-items="Model.StatusOptions">
            <option value="">All statuses</option>
        </select>
    </div>
    <div class="col-sm-4 col-lg-3">
        <label for="propertyId" class="form-label">Property</label>
        <select id="propertyId" name="propertyId" class="form-select" asp-items="Model.PropertyOptions">
            <option value="">All properties</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a class="btn btn-link" asp-action="Index">Clear</a>
    </div>
</form>

@await Component.InvokeAsync("Grid", new { grid = Model.Grid(Url.Action("List", "ApplicationsApi")!) })

@section Scripts {
    <script src="~/js/grid.js" asp-append-version="true"></script>
}
