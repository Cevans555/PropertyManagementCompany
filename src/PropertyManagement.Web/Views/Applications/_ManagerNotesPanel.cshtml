@model ApplicationPageViewModel

<section class="card manager-only mt-4" aria-labelledby="notes-heading">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span class="d-flex align-items-center gap-2">
            <span id="notes-heading">Manager notes</span>
            <span class="manager-only-tag">Internal</span>
        </span>
        <button type="button" class="btn btn-sm btn-outline-primary"
                data-modal-url="@Url.Action("Add", "ManagerNotes", new { applicationId = Model.Id })"
                data-modal-refresh="#manager-notes">
            Add note
        </button>
    </div>
    <div class="card-body">
        <p class="small text-muted">Only property managers see these. They are never shown to applicants.</p>
        <div id="manager-notes" data-refresh-url="@Url.Action("List", "ManagerNotes", new { id = Model.Id })">
            @await Component.InvokeAsync("ManagerNotes", new { applicationId = Model.Id })
        </div>
    </div>
</section>
