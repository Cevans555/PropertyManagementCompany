@using PropertyManagement.Web.Controllers
@{
    ViewData["Title"] = "Available units";
}

<h1 class="h3 mb-3">Available units</h1>
<p class="text-muted">Units without a current lease. Start an application, or continue one you already have in progress.</p>

@if (TempData[ApplicationsController.ErrorMessageKey] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

@await Component.InvokeAsync("AvailableUnits")
