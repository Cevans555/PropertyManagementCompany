@model ApplicationPageViewModel
@using System.Globalization
@{
    ViewData["Title"] = $"Application - Unit {Model.Header.UnitNumber}";
    var usd = CultureInfo.GetCultureInfo("en-US");
    var sections = new[]
    {
        (Section: ApplicationSection.Applicant, Label: "Applicant information"),
        (Section: ApplicationSection.Residences, Label: "Residence history"),
        (Section: ApplicationSection.Summary, Label: "Summary")
    };
    var currentIndex = Array.FindIndex(sections, s => s.Section == Model.Section);
    var pageErrors = ViewData.ModelState[string.Empty]?.Errors;
}

<div class="page-header">
    <div>
        <h1>@Model.Header.PropertyName &middot; Unit @Model.Header.UnitNumber</h1>
        <p class="page-subtitle">
            @Model.Header.UnitTypeName &middot; @Model.Header.Bedrooms bedroom(s) &middot; @Model.Header.MonthlyRent.ToString("C0", usd)/month
        </p>
    </div>
    <div class="page-actions">
        <partial name="_StatusBadge" model="Model.Header.Status" />
        @if (Model.CanWithdraw)
        {
            <button type="button" class="btn btn-sm btn-outline-danger"
                    data-modal-url="@Url.Action("Withdraw", new { id = Model.Id })"
                    data-modal-reload="true">
                Withdraw
            </button>
        }
    </div>
</div>

@if (Model.CanReview)
{
    <partial name="_ReviewActions" model="Model" />
}

@if (!Model.CanEdit && Model.IsApplicantOnApplication && !Model.Header.Status.IsTerminal())
{
    <div class="alert alert-secondary" role="status">
        This application is @Model.Header.Status.DisplayName().ToLowerInvariant(), so it can't be changed right now.
    </div>
}

@if (pageErrors is { Count: > 0 })
{
    <div class="alert alert-danger" role="alert">
        @foreach (var error in pageErrors)
        {
            <div>@error.ErrorMessage</div>
        }
    </div>
}

<nav aria-label="Application sections">
    <ol class="section-steps">
        @for (var i = 0; i < sections.Length; i++)
        {
            var step = sections[i];
            var state = i == currentIndex ? "is-current" : i < currentIndex ? "is-done" : null;
            <li class="@state">
                @if (Model.CanEdit)
                {
                    <span class="step-link" aria-current="@(state == "is-current" ? "step" : null)">@step.Label</span>
                }
                else
                {
                    <a class="step-link" aria-current="@(state == "is-current" ? "step" : null)"
                       asp-action="Details" asp-route-id="@Model.Id" asp-route-section="@step.Section">@step.Label</a>
                }
            </li>
        }
    </ol>
</nav>

@if (Model.CanEdit)
{
    <form method="post" asp-action="Details" asp-route-id="@Model.Id">
        <input type="hidden" asp-for="Section" />

        <div class="card mb-3">
            <div class="card-body">
                <partial name="_ApplicationSection" model="Model" />
            </div>
        </div>

        <div class="form-actions">
            @if (Model.Section == ApplicationSection.Summary)
            {
                <button type="submit" name="command" value="@ApplicationCommands.Submit" class="btn btn-primary btn-lg px-4 ms-auto"
                        disabled="@(Model.SubmitBlockers.Count > 0)">
                    Submit application
                </button>
            }
            else
            {
                <button type="submit" name="command" value="@ApplicationCommands.Continue" class="btn btn-primary ms-auto">Continue</button>
            }

            @if (Model.Section != ApplicationSection.Applicant)
            {
                <button type="submit" name="command" value="@ApplicationCommands.Back" class="btn btn-outline-secondary order-first" formnovalidate>
                    Back
                </button>
            }
        </div>
    </form>
}
else
{
    <div class="card mb-3">
        <div class="card-body">
            <partial name="_ApplicationSection" model="Model" />
        </div>
    </div>

    <div class="form-actions">
        @if (Model.Section != ApplicationSection.Applicant)
        {
            <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id" asp-route-section="@Model.Section.Previous()">Back</a>
        }
        @if (Model.Section != ApplicationSection.Summary)
        {
            <a class="btn btn-outline-primary ms-auto" asp-action="Details" asp-route-id="@Model.Id" asp-route-section="@Model.Section.Next()">Next</a>
        }
    </div>
}

@if (Model.CanManageNotes)
{
    <partial name="_ManagerNotesPanel" model="Model" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
