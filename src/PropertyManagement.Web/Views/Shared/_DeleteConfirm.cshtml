@model DeleteConfirmViewModel

<form method="post" action="@Model.PostUrl" asp-antiforgery="true">
    @foreach (var field in Model.HiddenFields ?? new Dictionary<string, string>())
    {
        <input type="hidden" name="@field.Key" value="@field.Value" />
    }
    <div class="modal-header">
        <h2 class="modal-title fs-5">@Model.Title</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2" role="alert"></div>
        <p class="mb-0">@Model.Message</p>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger">@Model.ConfirmText</button>
    </div>
</form>
