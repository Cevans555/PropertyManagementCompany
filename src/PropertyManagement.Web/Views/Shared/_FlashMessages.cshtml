@using PropertyManagement.Web.Controllers
@if (TempData[ApplicationsController.StatusMessageKey] is string statusMessage)
{
    <div class="alert alert-success" role="status">@statusMessage</div>
}
@if (TempData[ApplicationsController.WarningMessageKey] is string warningMessage)
{
    <div class="alert alert-warning" role="status">@warningMessage</div>
}
@if (TempData[ApplicationsController.ErrorMessageKey] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}
