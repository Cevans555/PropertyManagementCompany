@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6 text-center">
        <h1 class="h3 mb-3">@ViewData["Title"]</h1>
        <p class="text-muted">
            The request couldn't be completed. Going back and trying again usually works; if it keeps happening,
            the request ID below identifies this one in the logs.
        </p>

        @if (Model.ShowRequestId)
        {
            <p class="text-muted small mb-4">Request ID: <code>@Model.RequestId</code></p>
        }

        <a class="btn btn-outline-primary" asp-controller="Home" asp-action="Index">Go to the home page</a>
    </div>
</div>
