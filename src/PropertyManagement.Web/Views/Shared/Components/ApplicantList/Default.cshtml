@model ApplicantListViewModel

<ul class="list-group mb-2">
    @foreach (var person in Model.People)
    {
        <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>
                @person.Name
                <span class="small text-muted ms-1">@person.Email</span>
                @if (person.IsPrimary)
                {
                    <span class="badge text-bg-light border ms-1">Primary</span>
                }
            </span>
            @if (person.HasSavedDetails)
            {
                <span class="badge text-bg-success">Information saved</span>
            }
            else
            {
                <span class="badge text-bg-warning">Information needed</span>
            }
        </li>
    }
</ul>

@if (Model.Editable)
{
    <button type="button" class="btn btn-sm btn-outline-primary"
            data-modal-url="@Url.Action("AddCoApplicant", "Applications", new { applicationId = Model.ApplicationId })"
            data-modal-refresh="#applicant-list">
        Add co-applicant
    </button>
}
