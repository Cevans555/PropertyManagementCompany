@model ManagerNotesViewModel
@using System.Globalization
@{
    var usd = CultureInfo.GetCultureInfo("en-US");
}

@if (Model.Notes.Count == 0)
{
    <p class="text-muted mb-0">No notes yet.</p>
}
else
{
    <ul class="list-group">
        @foreach (var note in Model.Notes)
        {
            <li class="list-group-item">
                <div class="d-flex flex-wrap justify-content-between gap-2">
                    <div class="small text-muted">
                        @note.Author &middot; @note.CreatedAt.ToString("MMM d, yyyy h:mm tt", usd) UTC
                        @if (note.ModifiedAt is { } modifiedAt)
                        {
                            <span>&middot; edited @(note.ModifiedBy is null ? "" : $"by {note.ModifiedBy} ")@modifiedAt.ToString("MMM d, yyyy", usd)</span>
                        }
                    </div>
                    <div class="text-nowrap">
                        <button type="button" class="btn btn-sm btn-link p-0 me-2"
                                data-modal-url="@Url.Action("Edit", "ManagerNotes", new { id = note.Id })"
                                data-modal-refresh="#manager-notes">
                            Edit
                        </button>
                        <button type="button" class="btn btn-sm btn-link text-danger p-0"
                                data-modal-url="@Url.Action("Delete", "ManagerNotes", new { id = note.Id })"
                                data-modal-refresh="#manager-notes">
                            Remove
                        </button>
                    </div>
                </div>
                <p class="mb-0 mt-1" style="white-space: pre-line">@note.Text</p>
            </li>
        }
    </ul>
}
