@model ResidenceFormViewModel
@{
    var isNew = Model.Id is null;
    var postUrl = isNew
        ? Url.Action("Create", "ApplicationResidences", new { applicationId = Model.ApplicationId })
        : Url.Action("Edit", "ApplicationResidences", new { id = Model.Id });
}

<form method="post" action="@postUrl" asp-antiforgery="true">
    <input type="hidden" asp-for="ResidenceSectionVersion" />

    <div class="modal-header">
        <h2 class="modal-title fs-5">@(isNew ? "Add residence" : "Edit residence")</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2" role="alert"></div>

        <div class="mb-3">
            <label asp-for="Street" class="form-label"></label>
            <input asp-for="Street" class="form-control" />
            <span asp-validation-for="Street" class="text-danger"></span>
        </div>
        <div class="row g-3 mb-3">
            <div class="col-sm-5">
                <label asp-for="City" class="form-label"></label>
                <input asp-for="City" class="form-control" />
                <span asp-validation-for="City" class="text-danger"></span>
            </div>
            <div class="col-sm-3">
                <label asp-for="State" class="form-label"></label>
                <input asp-for="State" class="form-control" />
                <span asp-validation-for="State" class="text-danger"></span>
            </div>
            <div class="col-sm-4">
                <label asp-for="PostalCode" class="form-label"></label>
                <input asp-for="PostalCode" class="form-control" />
                <span asp-validation-for="PostalCode" class="text-danger"></span>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-sm-6">
                <label asp-for="LandlordName" class="form-label"></label>
                <input asp-for="LandlordName" class="form-control" />
                <span asp-validation-for="LandlordName" class="text-danger"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="LandlordPhone" class="form-label"></label>
                <input asp-for="LandlordPhone" class="form-control" />
                <span asp-validation-for="LandlordPhone" class="text-danger"></span>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-sm-6">
                <label asp-for="MoveInDate" class="form-label"></label>
                <input asp-for="MoveInDate" class="form-control" type="date" />
                <span asp-validation-for="MoveInDate" class="text-danger"></span>
            </div>
            <div class="col-sm-6">
                <label asp-for="MoveOutDate" class="form-label"></label>
                <input asp-for="MoveOutDate" class="form-control" type="date" />
                <span asp-validation-for="MoveOutDate" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">@(isNew ? "Add residence" : "Save changes")</button>
    </div>
</form>
